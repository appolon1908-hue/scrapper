# All image references must be immutable digests.
SCRAPPER_IMAGE=ghcr.io/appolon1908-hue/scrapper@sha256:REPLACE_WITH_RELEASE_DIGEST
KONG_IMAGE=kong/kong-gateway@sha256:REPLACE_WITH_APPROVED_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_APPROVED_DIGEST

SCRAPPER_ENV_FILE=/opt/codestra-scrapper/staging/app.env
DATABASE_URL_FILE=/opt/codestra-scrapper/staging/secrets/database_url
POSTGRES_PASSWORD_FILE=/opt/codestra-scrapper/staging/secrets/postgres_password
SERVICE_PRINCIPALS_FILE=/opt/codestra-scrapper/staging/secrets/service_principals.json
EIN_FINGERPRINT_PEPPER_FILE=/opt/codestra-scrapper/staging/secrets/ein_fingerprint_pepper
OUTBOUND_HMAC_SECRET_FILE=/opt/codestra-scrapper/staging/secrets/outbound_hmac
OUTBOUND_BEARER_TOKEN_FILE=/opt/codestra-scrapper/staging/secrets/middleware_token
OUTBOUND_CA_FILE=/opt/codestra-scrapper/staging/secrets/middleware_ca.pem
OUTBOUND_CLIENT_CERT_FILE=/opt/codestra-scrapper/staging/secrets/client_cert.pem
OUTBOUND_CLIENT_KEY_FILE=/opt/codestra-scrapper/staging/secrets/client_key.pem
INTEGRATION_CLIENT_CA_FILE=/opt/codestra-scrapper/staging/secrets/integration_client_ca.pem

ACME_EMAIL=operations@codestra.co
SCRAPPER_API_DOMAIN=scraper-staging.codestra.co
SCRAPPER_INTEGRATION_DOMAIN=scraper-integrations-staging.codestra.co
INTEGRATION_ALLOWLIST=10.40.0.1/32 127.0.0.1/32

# Mandatory staging safety gates.
ENABLE_EXTERNAL_DELIVERY=false
ENABLE_REGISTRY_ENRICHMENT=false
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
OUTBOX_LEASE_SECONDS=600
