NODE_ENV=development
ROLE=all
PORT=3000
DATABASE_URL=postgresql://scrapper:change-me@postgres:5432/scrapper
REDIS_URL=redis://redis:6379
SERVICE_PRINCIPALS_FILE=/run/secrets/scrapper_service_principals
SCRAPER_USER_AGENT=CodestraBusinessCrawler/2.0 (+https://codestra.co/crawler-policy)
DEFAULT_COUNTRY_CODE=US
MAX_JOB_COMPANIES=500
MAX_JOB_PAGES=5000
MAX_JOB_RUNTIME_SECONDS=7200
HTTP_CONCURRENCY=12
BROWSER_CONCURRENCY=2
JOB_CONCURRENCY=2
PER_HOST_REQUESTS_PER_SECOND=1
MIDDLEWARE_BASE_URL=https://middleware.internal
MIDDLEWARE_RESULTS_PATH=/api/v2/scraper/results/batches
MIDDLEWARE_EVENTS_PATH=/api/v2/scraper/jobs/events
OUTBOUND_HMAC_SECRET_FILE=/run/secrets/scrapper_outbound_hmac
OUTBOUND_BEARER_TOKEN_FILE=/run/secrets/scrapper_middleware_token
OUTBOUND_CA_FILE=/run/secrets/middleware_ca.pem
OUTBOUND_CLIENT_CERT_FILE=/run/secrets/scrapper_client.pem
OUTBOUND_CLIENT_KEY_FILE=/run/secrets/scrapper_client.key
OUTBOUND_ALLOWED_HOSTS=middleware.internal,10.40.0.1
EIN_FINGERPRINT_PEPPER_FILE=/run/secrets/ein_fingerprint_pepper
DATA_RETENTION_DAYS=30
RAW_PAGE_RETENTION_DAYS=7
DELIVERY_BATCH_SIZE=100
DELIVERY_MAX_ATTEMPTS=12
ENABLE_EXTERNAL_DELIVERY=false
ENABLE_REGISTRY_ENRICHMENT=false
